    %% =========================

    %% CANDIDATE_PROFILE ||--o{ CV : owns
    CV_TEMPLATE ||--o{ CV : uses

    CV ||--o{ WORK_EXPERIENCE : contains
    CV ||--o{ EDUCATION : contains

    CV ||--o{ CV_SKILL : has
    SKILL ||--o{ CV_SKILL : used_in

    CV ||--o{ PROJECT : contains
    PROJECT ||--o{ PROJECT_TECHNOLOGY : uses

