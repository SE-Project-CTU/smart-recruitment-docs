erDiagram

    USER {
        UUID id PK
        VARCHAR email UK
        VARCHAR phone UK
        VARCHAR password_hash
        VARCHAR full_name
        VARCHAR avatar_url
        ENUM status
        DATETIME created_at
        DATETIME updated_at
    }

    ROLE {
        UUID id PK
        VARCHAR name UK
    }

    PERMISSION {
        UUID id PK
        VARCHAR name UK
        VARCHAR description
        DATETIME created_at
    }

    USER_ROLE {
        UUID user_id PK, FK
        UUID role_id PK, FK
    }

    ROLE_PERMISSION {
        UUID role_id PK, FK
        UUID permission_id PK, FK
    }

    REFRESH_TOKEN {
        UUID id PK
        UUID user_id FK
        VARCHAR token_hash
        DATETIME expires_at
        DATETIME revoked_at
        DATETIME created_at
    }

