---
config:
  layout: elk
---

erDiagram
    USER {
        UUID id PK
        VARCHAR email UK
        VARCHAR phone UK
        VARCHAR password_hash
        VARCHAR full_name
        VARCHAR avatar_url
        ENUM status
        DATETIME created_at
        DATETIME updated_at
    }

    ROLE {
        UUID id PK
        VARCHAR name UK
    }

    PERMISSION {
        UUID id PK
        VARCHAR name UK
        VARCHAR description
        DATETIME created_at
    }

    USER_ROLE {
        UUID user_id PK, FK
        UUID role_id PK, FK
    }

    ROLE_PERMISSION {
        UUID role_id PK, FK
        UUID permission_id PK, FK
    }

    REFRESH_TOKEN {
        UUID id PK
        UUID user_id FK
        VARCHAR token_hash
        DATETIME expires_at
        DATETIME revoked_at
        DATETIME created_at
    }

    COMPANY {
        UUID id PK
        VARCHAR name
        VARCHAR tax_code UK
        VARCHAR email
        VARCHAR phone
        VARCHAR address
        VARCHAR website
        TEXT description
        VARCHAR logo_url
        ENUM verification_status
        DATETIME verified_at
        DATETIME created_at
        DATETIME updated_at
    }

    %% UNIQUE(company_id, user_id)
    COMPANY_MEMBERSHIP {
        UUID id PK
        UUID company_id FK
        UUID user_id FK
        ENUM role
        ENUM status
        DATETIME joined_at
        DATETIME created_at
    }

    COMPANY_INVITATION {
        UUID id PK
        UUID company_id FK
        UUID inviter_id FK
        UUID invitee_id FK
        ENUM status
        DATETIME expires_at
        DATETIME created_at
    }

    COMPANY_JOIN_REQUEST {
        UUID id PK
        UUID company_id FK
        UUID user_id FK
        ENUM status
        UUID reviewed_by FK
        DATETIME reviewed_at
        DATETIME created_at
    }

    COMPANY_FOLLOW {
        UUID user_id PK, FK
        UUID company_id PK, FK
        DATETIME created_at
    }

    JOB_POSTING {
        UUID id PK
        UUID company_id FK
        UUID created_by FK
        VARCHAR title
        UUID location_id FK
        VARCHAR detailed_location

        %% Overall requirements
        INTEGER experience_years
        ENUM job_level 
        VARCHAR education_level
        INTEGER vacancies
        ENUM work_mode 
        %% Full-time, Part-time, Contract, Internship, Freelance
        ENUM job_type 
        %% Remote, On-site, Hybrid

        %% Detailed information 
        TEXT description
        TEXT requirements
        TEXT benefits

        DECIMAL salary_min
        DECIMAL salary_max

        BOOLEAN salary_negotiable

        DATETIME deadline
        ENUM status

        DATETIME created_at
        DATETIME updated_at
    }

    INDUSTRY_GROUP {
        UUID id PK
        VARCHAR name
        BOOLEAN is_active
    }

    INDUSTRY {
        UUID id PK
        UUID group_id FK
        VARCHAR name UK
        ENUM status
        BOOLEAN is_active
    }

    JOB_INDUSTRY {
        UUID job_id PK, FK
        UUID industry_id PK, FK
    }

    LOCATION {
        UUID id PK
        VARCHAR name UK
        ENUM status
    }

    CV_TEMPLATE {
        UUID id PK
        VARCHAR name
        VARCHAR thumbnail_url
        VARCHAR template_url
        BOOLEAN is_active
        DATETIME created_at
    }

    CV {
        UUID id PK
        UUID candidate_id FK
        UUID template_id FK
        VARCHAR title
        JSONB content
        JSONB presentation
        ENUM language
        BOOLEAN is_public
        DATETIME created_at
        DATETIME updated_at
    }

    CV_VERSION {
        UUID id PK
        UUID cv_id FK
        UUID template_id FK
        JSONB content
        JSONB presentation
        ENUM language
        INTEGER version_number
        DATETIME created_at
    }

    APPLICATION {
        UUID id PK
        UUID job_id FK
        UUID candidate_id FK
        UUID cv_version_id FK
        VARCHAR uploaded_cv_url
        TEXT cover_letter
        ENUM status
        DATETIME applied_at
        DATETIME updated_at
    }

    APPLICATION_STATUS_HISTORY {
        UUID id PK
        UUID application_id FK
        ENUM status
        UUID changed_by FK
        TEXT note
        DATETIME created_at
    }

    AI_MATCH_RESULT {
        UUID id PK
        UUID application_id FK
        DECIMAL score
        TEXT analysis
        DATETIME created_at
    }

    %% UNIQUE(candidate_id, job_id)
    JOB_RECOMMENDATION {
        UUID id PK
        UUID candidate_id FK
        UUID job_id FK
        DECIMAL score
        DATETIME generated_at
    }

    MEDIA_FILE {
        UUID id PK
        UUID owner_id FK
        VARCHAR file_name
        VARCHAR file_url
        VARCHAR file_type
        BIGINT file_size
        DATETIME created_at
    }


    %% =========================
    %% ACCOUNT
    %% =========================

    USER ||--o{ USER_ROLE : has
    ROLE ||--o{ USER_ROLE : assigned_to
    ROLE ||--o{ ROLE_PERMISSION : grants
    PERMISSION ||--o{ ROLE_PERMISSION : included_in

    USER ||--o{ REFRESH_TOKEN : owns

    %% =========================
    %% COMPANY
    %% =========================

    USER ||--o{ COMPANY_MEMBERSHIP : joins
    COMPANY ||--o{ COMPANY_MEMBERSHIP : has

    COMPANY ||--o{ COMPANY_INVITATION : sends
    USER ||--o{ COMPANY_INVITATION : inviter
    USER ||--o{ COMPANY_INVITATION : invitee

    COMPANY ||--o{ COMPANY_JOIN_REQUEST : receives
    USER ||--o{ COMPANY_JOIN_REQUEST : submits
    USER ||--o{ COMPANY_JOIN_REQUEST : reviews

    USER ||--o{ COMPANY_FOLLOW : follows
    COMPANY ||--o{ COMPANY_FOLLOW : followed_by

    %% =========================
    %% RECRUITMENT
    %% =========================

    COMPANY ||--o{ JOB_POSTING : publishes
    USER ||--o{ JOB_POSTING : creates

    JOB_POSTING ||--o{ JOB_INDUSTRY : has
    INDUSTRY_GROUP ||--o{ INDUSTRY : contains
    INDUSTRY ||--o{ JOB_INDUSTRY : belongs_to
    LOCATION ||--o{ JOB_POSTING : located_at

    %% =========================
    %% CV
    %% =========================

    USER ||--o{ CV : owns
    CV_TEMPLATE ||--o{ CV : uses
    CV_TEMPLATE ||--o{ CV_VERSION : uses

    %% =========================
    %% APPLICATION
    %% =========================

    JOB_POSTING ||--o{ APPLICATION : receives
    USER ||--o{ APPLICATION : submits
    CV ||--o{ CV_VERSION : has

    APPLICATION ||--o{ APPLICATION_STATUS_HISTORY : tracks
    APPLICATION }o--|| CV_VERSION : submitted_with
    USER ||--o{ APPLICATION_STATUS_HISTORY : changes

    %% =========================
    %% AI
    %% =========================

    APPLICATION ||--o| AI_MATCH_RESULT : analyzed_by
    CV_VERSION ||--o{ AI_MATCH_RESULT : analyzed_by

    JOB_POSTING ||--o{ JOB_RECOMMENDATION : recommended
    USER ||--o{ JOB_RECOMMENDATION : receives

    %% =========================
    %% MEDIA
    %% =========================

    USER ||--o{ MEDIA_FILE : owns